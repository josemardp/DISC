# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA PSICOMÉTRICO (DISC + SPRANGER + JUNG)
# ==============================================================================

# Chave de API do Gemini (Google AI Studio) - Obrigatória para relatórios
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Configurações do Banco de Dados
# Híbrido: Se deixado vazio ou sqlite, o sistema usará o arquivo local sqlite
DATABASE_URL=sqlite:///./psicometrico.db
# Para PostgreSQL (Exemplo Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disc_db

# Configurações do Redis (Mensageria e Filas)
REDIS_URL=redis://localhost:6379/0

# Configurações do Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Normas Big Five
# intra = régua interna do próprio respondente; public fica reservado para normas públicas versionadas.
NORM_MODE=intra
