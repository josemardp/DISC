# ==============================================================================
# CONFIGURAÇÕES DO SISTEMA PSICOMÉTRICO (DISC + SPRANGER + JUNG)
# ==============================================================================

# Chave de API do Gemini (Google AI Studio) - Obrigatória para relatórios
GEMINI_API_KEY=sua_chave_do_gemini_aqui

# Configurações do Banco de Dados
# Dev local: SQLite (padrão, sem configuração necessária)
DATABASE_URL=sqlite:///./psicometrico.db
#
# Produção (Vercel): usar o pooler do Supabase em Transaction mode, porta 6543.
# Defina em: Vercel → Project → Settings → Environment Variables
# DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# pgvector é opcional e reservado a uma evolução futura com embeddings.
# A F9 atual de reflexões pessoais não depende da extensão "vector".
#
# IMPORTANTE — Vercel Serverless: use SEMPRE o pooler (porta 6543, Transaction mode).
# Nunca use a conexão direta (porta 5432) em funções serverless — esgota conexões.
# Antes de publicar a API com reflexões pessoais, aplique no SQL Editor do Supabase:
# backend/schema/2026-06-19_personal_reflections.sql
# Essa migração não exige variável de ambiente nova.

# Configurações do Redis (Mensageria e Filas)
REDIS_URL=redis://localhost:6379/0

# Configurações do Servidor
ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Segurança
# Em produção, SECRET_KEY é obrigatória, deve ser longa e não pode usar o valor dev.
SECRET_KEY=dev-only-secret-key-change-before-production
# Em produção, defina uma ou mais origens separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000
# Seed demo e criação automática de schema só devem ficar ativos fora de produção.
ENABLE_DEMO_SEED=true
AUTO_CREATE_SCHEMA=true

# Normas Big Five
# intra = régua interna do próprio respondente; a primeira aplicação cria baseline e não retorna percentil interpretável.
# public = norma pública exploratória versionada em backend/app/norms_ipip_neo.json.
NORM_MODE=intra
NORM_SOURCE=open_psychometrics_2018
